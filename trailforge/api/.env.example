# Trailforge API — copy to .env (NEVER commit .env)

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# TRAILFORGE_MODEL=claude-haiku-4-5-20251001

# --- Server ---
# PORT=4100
NODE_ENV=development
ALLOWED_ORIGINS=https://aiwalkcorp.com,http://localhost:8000
# SKILL_DIR=../skill

# --- Database (Neon Postgres) ---
# Get from https://console.neon.tech — pooled URL for runtime, unpooled (direct) for migrations.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/trailforge?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/trailforge?sslmode=require

# --- Auth ---
# Generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(48)).reduce((s,b)=>s+b.toString(16).padStart(2,'0'),''))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Pricing (USD per 1M tokens) ---
# Used for ai_usage cost calculations. Update when pricing changes.
PRICE_INPUT_PER_MTOK=1.00
PRICE_OUTPUT_PER_MTOK=5.00
